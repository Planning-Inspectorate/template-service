{
  "name": "service-name",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "check-types": "npx tsc",
    "commitlint": "commitlint --from=$(git rev-parse $(git cherry origin/main | head -n 1 | cut -c 3-)^1)",
    "db-migrate-dev": "npm run migrate-dev --workspace @pins/service-name-database",
    "db-migrate-prod": "npm run migrate-prod --workspace @pins/service-name-database",
    "db-generate": "npm run generate --workspace @pins/service-name-database",
    "db-seed": "npm run seed --workspace @pins/service-name-database",
    "db-seed-prod": "npm run seed-prod --workspace @pins/service-name-database",
    "format": "npm run format-prettier && npm run format-css",
    "format-css": "stylelint \"**/*.{css,scss}\" --fix",
    "format-prettier": "prettier --write .",
    "format-prettier-check": "prettier --check .",
    "lint": "npm run lint-ts && npm run lint-css",
    "lint-css": "stylelint \"**/*.{css,scss}\"",
    "lint-ts": "npx eslint .",
    "prepare": "node .husky/install.mjs",
    "test": "node --test",
    "test-coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "@azure/functions": "^4.16.2",
    "@azure/identity": "^4.13.2",
    "@azure/msal-node": "^5.6.0",
    "@planning-inspectorate/core": "^1.2.0",
    "@prisma/adapter-mssql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@redis/entraid": "^6.2.1",
    "@types/lusca": "^1.7.5",
    "accessible-autocomplete": "^3.0.1",
    "body-parser": "^2.3.0",
    "connect-redis": "^10.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "govuk-frontend": "^6.4.0",
    "helmet": "^8.3.0",
    "lusca": "^1.7.0",
    "nunjucks": "^3.2.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@planning-inspectorate/coding-standards": "^1.1.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.4.0",
    "@types/nunjucks": "^3.2.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^7.10.0",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ],
    "*.{js,ts,json,md,prisma,yml,yaml,scss}": [
      "prettier --write"
    ]
  }
}
